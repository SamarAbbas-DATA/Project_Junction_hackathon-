# Optional: use an existing PostgreSQL database instead of the isolated local cluster.
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/hub_db
HUB_PORT=8000
ADT_PORT=8001
LIS_PORT=8002
FORMULARY_PORT=8003
SYNC_INTERVAL_MS=2000
OLLAMA_URL=http://127.0.0.1:11434
# Local assistant: indexed database lookup + Qwen, with no embeddings or RAG store.
# Install with: ollama pull qwen3.5:4b
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT_MS=180000
# Source APIs bind to loopback. Optionally require a token for direct source requests.
SOURCE_API_TOKEN=
# Automatically import synthetic CSV ZIP batches placed in output/data/inbox.
SYNTHETIC_AUTO_IMPORT=true
# New patients arrive in groups; organisms and S/R results follow on later ticks.
SYNTHETIC_IMPORT_GROUP_SIZE=1
SYNTHETIC_IMPORT_INTERVAL_MS=30000
# After every inbox batch finishes, the next startup clears only feed-owned
# patients/clinical rows and replays the same files. Incomplete feeds resume.
SYNTHETIC_REPLAY_ON_RESTART=true
# SYNTHETIC_INBOX=C:/path/to/another/inbox
# Python 3.8+ runs the supplied AMR inference code; no training packages required.
# PYTHON_BIN=C:/path/to/python.exe
# Anomaly test controls are available locally and disabled in NODE_ENV=production.
# Set false to hide and disable test-data injection in any environment.
ANOMALY_DEMO_ENABLED=true
